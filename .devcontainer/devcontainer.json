{
	"name": "Python 3",
	"image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
	"features": {
		"ghcr.io/devcontainers-extra/features/nox:2": {},
		"ghcr.io/devcontainers-extra/features/uv:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ritwickdey.LiveServer",
				"tamasfe.even-better-toml"
			]
		}
	},
	"postCreateCommand": "uv python install 3.10 3.11 3.12 3.13 3.14 && pip install -e .[dev,doc]"
}
